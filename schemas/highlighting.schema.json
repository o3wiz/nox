{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HighlightConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HighlightRule"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "HighlightRule": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "pattern",
        "color",
        "case_sensitive"
      ]
    }
  }
}
