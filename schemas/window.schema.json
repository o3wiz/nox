{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WindowConfig",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "format": "float",
      "minimum": 640,
      "maximum": 7680
    },
    "height": {
      "type": "number",
      "format": "float",
      "minimum": 480,
      "maximum": 4320
    },
    "maximized": {
      "type": "boolean"
    },
    "results_height": {
      "type": "number",
      "format": "float",
      "minimum": 100,
      "maximum": 1200
    },
    "filter_resize_sensitivity": {
      "type": "number",
      "format": "float",
      "minimum": 0.1,
      "maximum": 10.0,
      "default": 1.0
    },
    "show_status_bar": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
