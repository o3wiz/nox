{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "active": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "tabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SavedTab"
      }
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results_height": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "zoom_percent": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "active",
    "tabs",
    "recent"
  ],
  "$defs": {
    "SavedTab": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/SearchConfig"
        },
        "bookmarks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "selected": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "follow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "query",
        "options",
        "bookmarks",
        "selected",
        "follow"
      ]
    },
    "SearchConfig": {
      "$ref": "common.schema.json#/$defs/SearchConfig",
      "required": [
        "mode",
        "case_sensitive",
        "whole_word",
        "invert",
        "context_lines",
        "max_results",
        "presets"
      ],
      "unevaluatedProperties": false
    }
  }
}
