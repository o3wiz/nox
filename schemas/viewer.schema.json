{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewerConfig",
  "type": "object",
  "properties": {
    "line_numbers": {
      "type": "boolean"
    },
    "show_overview": {
      "type": "boolean"
    },
    "overview_width": {
      "type": "number",
      "format": "float",
      "minimum": 8,
      "maximum": 64
    },
    "line_height": {
      "type": "number",
      "format": "float",
      "minimum": 16,
      "maximum": 64
    },
    "tab_width": {
      "type": "integer",
      "format": "uint",
      "minimum": 1,
      "maximum": 16
    },
    "max_display_chars": {
      "type": "integer",
      "format": "uint",
      "minimum": 256,
      "maximum": 1000000
    },
    "follow": {
      "type": "boolean"
    },
    "include_bookmarks": {
      "type": "boolean"
    },
    "poll_interval_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 100,
      "maximum": 60000
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
