{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppearanceConfig",
  "type": "object",
  "properties": {
    "ui_font_family": {
      "type": "string"
    },
    "ui_font_size": {
      "$ref": "#/$defs/FontSize"
    },
    "font_family": {
      "type": "string"
    },
    "font_size": {
      "$ref": "#/$defs/FontSize"
    },
    "background": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "panel": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "foreground": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "muted": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "accent": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "text_selection_color": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "text_selection_opacity": {
      "type": "number",
      "format": "float",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "border": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "match_foreground": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "match_background": {
      "$ref": "common.schema.json#/$defs/HexColor"
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FontSize": {
      "type": "number",
      "format": "float",
      "minimum": 8,
      "maximum": 32
    }
  }
}
