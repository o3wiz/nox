{
  "$schema": "../schemas/highlighting.schema.json",
  "enabled": true,
  "rules": [
    {
      "name": "Errors",
      "pattern": "\\b(ERROR|FATAL|PANIC)\\b",
      "color": "#F38BA8",
      "case_sensitive": false
    },
    {
      "name": "Warnings",
      "pattern": "\\bWARN(ING)?\\b",
      "color": "#F9D58B",
      "case_sensitive": false
    },
    {
      "name": "Debug",
      "pattern": "\\b(DEBUG|TRACE)\\b",
      "color": "#8B9BB4",
      "case_sensitive": false
    }
  ]
}
